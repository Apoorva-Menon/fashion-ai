# Google Gemini API Key (Get at https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision Credentials (Path to service account json or ADC)
# Leave blank to use Application Default Credentials (ADC) or run in mock mode
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Model configurations
FASHION_FEATURE_MODEL=gemini-2.5-flash
FASHION_STYLIST_MODEL=gemini-2.5-flash
FASHION_TRYON_MODEL=gemini-2.5-flash

# Pipeline settings
FASHION_MOCK_MODE=false
FASHION_OUTPUT_DIR=data/output
